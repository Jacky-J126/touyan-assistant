# ===== LLM（OpenAI 兼容接口，必填）=====
# 管线生成所用的主模型
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 评测 Judge 双模型（阶段 3 起用）=====
# 每个样本由两个不同模型独立评分，分差 >=2 转人工仲裁
# 建议与主模型错开供应商，减少同源偏见
JUDGE_MODEL_A=
JUDGE_MODEL_B=

# ===== 数据源（阶段 4 起用）=====
# akshare：公告 / 行情 / 股吧，免费，无需 key
# tushare：研报 / 公告（可选，需在 tushare.pro 申请 token）
TUSHARE_TOKEN=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
