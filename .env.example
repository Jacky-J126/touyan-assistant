# 复制为 .env（已 gitignore，密钥永不入库），按需填写后 source .env

# ===== LLM（OpenAI 兼容接口，真实模式必填）=====
# 不配置时管线回退 MockLLM（G1 演示内容，零 key 可跑）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ===== 数据源（真实模式，默认 mock）=====
# mock：G1 演示数据（零配置）｜akshare：免费免 key｜tushare：需 TUSHARE_TOKEN
DATASOURCE=mock
TUSHARE_TOKEN=

# ===== 评测 Judge 双模型（evals/llm_eval.py，可选）=====
# 每个样本由两个不同模型独立评分，分差 >=2 转人工仲裁
# 建议与主模型错开供应商，减少同源偏见
JUDGE_MODEL_A_BASE_URL=
JUDGE_MODEL_A_API_KEY=
JUDGE_MODEL_A_MODEL=
JUDGE_MODEL_B_BASE_URL=
JUDGE_MODEL_B_API_KEY=
JUDGE_MODEL_B_MODEL=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
